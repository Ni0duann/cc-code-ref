{
  "publisher": "ni0duann",
  "name": "cc-code-ref",
  "displayName": "cc-code-ref",
  "version": "1.0.1",
  "private": true,
  "packageManager": "pnpm@10.27.0",
  "description": "Copy code references to clipboard for Claude Code in token-efficient format",
  "author": "Ni0daunn",
  "license": "MIT",
  "homepage": "https://github.com/Ni0duann/cc-code-ref",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ni0duann/cc-code-ref"
  },
  "bugs": {
    "url": "https://github.com/Ni0duann/cc-code-ref/issues"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/index.cjs",
  "icon": "res/icon.png",
  "files": [
    "LICENSE.md",
    "dist/*",
    "res/*"
  ],
  "engines": {
    "vscode": "^1.97.0"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "ccCodeRef.copyReference",
        "title": "Copy Code Reference for Claude Code",
        "category": "cc-code-ref"
      },
      {
        "command": "ccCodeRef.setFormat",
        "title": "Set Copy Format…",
        "category": "cc-code-ref"
      },
      {
        "command": "ccCodeRef.setPrefix",
        "title": "Set File Prefix…",
        "category": "cc-code-ref"
      },
      {
        "command": "ccCodeRef.resetConfig",
        "title": "Reset Format to Default",
        "category": "cc-code-ref"
      }
    ],
    "keybindings": [
      {
        "command": "ccCodeRef.copyReference",
        "key": "alt+c",
        "mac": "alt+c",
        "when": "editorTextFocus"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "ccCodeRef.copyReference",
          "group": "1_modification"
        }
      ]
    },
    "configuration": {
      "type": "object",
      "title": "cc-code-ref",
      "properties": {
        "ccCodeRef.format": {
          "type": "string",
          "default": "{prefix}{file} {start}-{end}",
          "description": "Output format. Placeholders: {prefix}, {file}, {start}, {end}, {selection}"
        },
        "ccCodeRef.prefix": {
          "type": "string",
          "default": "@",
          "description": "Value substituted for the {prefix} placeholder. Leave empty for none."
        }
      }
    }
  },
  "scripts": {
    "build": "tsdown src/index.ts --external vscode",
    "dev": "nr build --watch --sourcemap",
    "prepare": "nr update",
    "update": "vscode-ext-gen --output src/generated/meta.ts",
    "lint": "eslint .",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "vscode:prepublish": "nr build",
    "release": "bumpp",
    "ext:package": "vsce package --no-dependencies",
    "ext:publish": "vsxpub --no-dependencies"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^6.7.3",
    "@antfu/ni": "^28.0.0",
    "@types/node": "^25.0.3",
    "@types/vscode": "^1.97.0",
    "@vscode/vsce": "^3.7.1",
    "bumpp": "^10.3.2",
    "eslint": "^9.39.2",
    "ovsx": "^0.10.7",
    "reactive-vscode": "^1.0.0-beta.2",
    "taze": "^19.9.2",
    "tsdown": "^0.19.0-beta.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.0",
    "vitest": "^4.0.16",
    "vscode-ext-gen": "^1.5.1",
    "vsxpub": "^0.1.2"
  }
}
